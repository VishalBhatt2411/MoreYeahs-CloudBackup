# Server settings only. Salesforce Client ID / Secret are NOT set here.
# The platform admin enters them inside the app (Platform setup)
# and they are stored encrypted in the database.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/cloudbackup
# Public address of the web app (used to build the Salesforce callback address).
APP_URL=http://localhost:5173
# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Exactly 64 hex characters (32 bytes). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
STORAGE_DIR=./.storage
