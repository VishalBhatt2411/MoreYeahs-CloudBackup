generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  VIEWER
  AUDITOR
}

enum RunMode {
  FULL
  INCREMENTAL
}

enum Environment {
  PRODUCTION
  SANDBOX
}

enum ConnectionStatus {
  ACTIVE
  NEEDS_RECONNECT
  DISCONNECTED
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum ItemKind {
  METADATA
  OBJECT
}

enum ItemStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  SKIPPED
}

model Tenant {
  id          String           @id @default(cuid())
  name        String
  createdAt   DateTime         @default(now())
  users       User[]
  connections OrgConnection[]
  runs        BackupRun[]
  audit       AuditLog[]
  invites     Invite[]

  // Settings screen
  timeZone             String  @default("UTC")
  retentionDays        Int? // null = keep backups forever
  defaultScheduleHours Int? // given to every newly connected org; null = no automatic backups
  alertOnFailure       Boolean @default(true)
  alertEmail           String?
  sessionHours         Int     @default(168) // how long a sign-in lasts

  // Legal hold: while on, nothing of this customer is deleted (retention, "delete my backups", account deletion).
  legalHold       Boolean   @default(false)
  legalHoldReason String?
  legalHoldAt     DateTime?

  checkpoints ObjectCheckpoint[]
}

model Invite {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String
  role        Role
  tokenHash   String    @unique
  invitedById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?

  @@index([tenantId])
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String
  role            Role      @default(OWNER)
  isPlatformAdmin Boolean   @default(false)
  active          Boolean   @default(true)
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  lastLoginAt     DateTime?
  // Logins issued before this moment are refused (set when the password is reset).
  passwordChangedAt DateTime?
  // null = the person has not proven they own the email address yet.
  emailVerifiedAt DateTime?
  resets          PasswordReset[]
  verifications   EmailVerification[]

  @@index([tenantId])
}

// A "forgot password" link. Only the hash of the token is stored. One use, short life.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

// An "verify your email" link. Only the hash of the token is stored. One use, 24 hours.
model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

// One row only (id = "default"). The shared Salesforce Connected App, entered by the platform admin.
model SalesforceAppConfig {
  id              String   @id
  clientId        String
  clientSecretEnc String
  updatedAt       DateTime @updatedAt
  updatedById     String?
}

// One row only (id = "default"). Where the platform sends email from. Entered by the platform admin.
model EmailConfig {
  id          String   @id
  host        String
  port        Int
  secure      Boolean  @default(false) // true = TLS from the start (usually port 465)
  username    String?
  passwordEnc String?
  fromEmail   String
  fromName    String   @default("MoreYeahs CloudBackup")
  updatedAt   DateTime @updatedAt
  updatedById String?
}

// One row per backup we tried to email about (so we never send two emails for the same run).
model AlertLog {
  id        String   @id @default(cuid())
  tenantId  String
  runId     String   @unique
  toEmail   String
  status    String // SENT | FAILED | SKIPPED
  detail    String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// Short-lived record that links the "Connect Salesforce" click to the callback.
model OAuthState {
  state            String   @id
  tenantId         String
  userId           String
  environment      Environment
  label            String
  codeVerifierEnc  String
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  @@index([expiresAt])
}

model OrgConnection {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label           String
  environment     Environment
  loginUrl        String
  instanceUrl     String
  sfOrgId         String
  sfUserId        String
  username        String
  orgName         String?
  refreshTokenEnc String
  status          ConnectionStatus @default(ACTIVE)
  lastError       String?
  connectedAt     DateTime         @default(now())
  lastCheckedAt   DateTime?
  scheduleHours   Int?
  nextRunAt       DateTime?
  /// What automatic backups cover (same shape as a manual run's selection). Null = everything.
  defaultSelection Json?
  runs            BackupRun[]
  checkpoints     ObjectCheckpoint[]

  @@unique([tenantId, sfOrgId])
  @@index([tenantId])
}

model BackupRun {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId String
  connection   OrgConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  status       RunStatus     @default(QUEUED)
  trigger      String        @default("manual")
  options      Json?
  startedById  String?
  createdAt    DateTime      @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  message      String?
  items        BackupItem[]

  // Queue and worker
  mode          RunMode   @default(FULL)
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  leaseUntil    DateTime? // a running backup renews this every few seconds; if it lapses the worker is gone
  workerId      String?
  nextAttemptAt DateTime? // do not start before this moment (retry back-off)

  @@index([status, createdAt])
  @@index([tenantId, createdAt])
  @@index([connectionId])
}

model BackupItem {
  id            String     @id @default(cuid())
  runId         String
  run           BackupRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  tenantId      String
  kind          ItemKind
  name          String
  status        ItemStatus @default(PENDING)
  expectedCount Int?
  rowCount      Int?
  bytes         Int?
  sha256        String?
  filePath      String?
  note          String?
  error         String?
  createdAt     DateTime   @default(now())
  finishedAt    DateTime?
  files         Json? // metadata items: the list of files written (so a resumed run can rebuild the manifest)
  mode          RunMode?
  changedCount  Int? // incremental: rows added or changed since the last copy
  deletedCount  Int? // incremental: rows that were deleted in Salesforce since the last copy

  @@index([runId])
  @@index([tenantId])
}

// Where the last good copy of an object stands, so the next backup can copy only what changed.
model ObjectCheckpoint {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId String
  connection   OrgConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  objectName   String
  watermark    DateTime // rows changed after this moment are copied next time
  lastFilePath String
  lastItemId   String?
  lastFullAt   DateTime
  needsFull    Boolean       @default(false)
  updatedAt    DateTime      @updatedAt

  @@unique([connectionId, objectName])
  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  action    String
  target    String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}
